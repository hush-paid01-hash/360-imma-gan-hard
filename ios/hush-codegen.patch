+#if defined(MEMFUNC_USE_MACHVM)
+
+// iOS 26 breakpoint protocol understood by StikDebug's universal.js (arm64 only).
+#if defined(__aarch64__)
+extern "C"
+{
+	__attribute__((noinline, optnone, naked)) void* HushJIT26PrepareRegion(void*, size_t)
+	{
+		__asm__("mov x16, #1\n brk #0xf00d\n ret\n");
+	}
+	__attribute__((noinline, optnone, naked)) void HushJIT26Detach(void)
+	{
+		__asm__("mov x16, #0\n brk #0xf00d\n ret\n");
+	}
+}
+extern "C" int csops(pid_t, unsigned int, void*, size_t);
+#endif
+
+namespace
+{
+	struct Jit26Pool
+	{
+		std::mutex lock;
+		uint8_t* rx = nullptr;
+		uint8_t* rw = nullptr;
+		size_t size = 0;
+		bool active = false;
+		std::map<size_t, size_t> freeList; //offset -> length
+
+		bool Contains(const void* p) const
+		{
+			return active && p >= rx && p < rx + size;
+		}
+
+		bool Alloc(size_t len, size_t& offset)
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			for(auto it = freeList.begin(); it != freeList.end(); ++it)
+			{
+				if(it->second < len) continue;
+				offset = it->first;
+				auto remaining = it->second - len;
+				auto next = it->first + len;
+				freeList.erase(it);
+				if(remaining) freeList[next] = remaining;
+				return true;
+			}
+			return false;
+		}
+
+		void Free(size_t offset, size_t len)
+		{
+			std::lock_guard<std::mutex> guard(lock);
+			auto it = freeList.emplace(offset, len).first;
+			auto next = std::next(it);
+			if(next != freeList.end() && it->first + it->second == next->first)
+			{
+				it->second += next->second;
+				freeList.erase(next);
+			}
+			if(it != freeList.begin())
+			{
+				auto prev = std::prev(it);
+				if(prev->first + prev->second == it->first)
+				{
+					prev->second += it->second;
+					freeList.erase(it);
+				}
+			}
+		}
+	};
+
+	Jit26Pool g_jit26Pool;
+}
+
+bool CMemoryFunction::IsJit26Active()
+{
+	return g_jit26Pool.active;
+}
+
+bool CMemoryFunction::InitializeJit26(size_t poolSize)
+{
+#if defined(__aarch64__)
+	if(g_jit26Pool.active) return true;
+
+	//A breakpoint without an attached debugger kills the process, so verify first
+	const unsigned int CS_OPS_STATUS = 0;
+	const unsigned int CS_DEBUGGED = 0x10000000;
+	unsigned int flags = 0;
+	if(csops(getpid(), CS_OPS_STATUS, &flags, sizeof(flags)) != 0 || !(flags & CS_DEBUGGED)) return false;
+
+	bool success = false;
+	for(size_t size = poolSize; size >= (32u << 20) && !success; size /= 2)
+	{
+		void* rx = HushJIT26PrepareRegion(nullptr, size);
+		if(!rx || rx == reinterpret_cast<void*>(-1)) continue;
+
+		vm_address_t rw = 0;
+		vm_prot_t curProt = 0, maxProt = 0;
+		kern_return_t result = vm_remap(mach_task_self(), &rw, size, 0, VM_FLAGS_ANYWHERE,
+		                                mach_task_self(), reinterpret_cast<vm_address_t>(rx), FALSE,
+		                                &curProt, &maxProt, VM_INHERIT_NONE);
+		if(result != KERN_SUCCESS) continue;
+		result = vm_protect(mach_task_self(), rw, size, FALSE, VM_PROT_READ | VM_PROT_WRITE);
+		if(result != KERN_SUCCESS)
+		{
+			vm_deallocate(mach_task_self(), rw, size);
+			continue;
+		}
+
+		g_jit26Pool.rx = reinterpret_cast<uint8_t*>(rx);
+		g_jit26Pool.rw = reinterpret_cast<uint8_t*>(rw);
+		g_jit26Pool.size = size;
+		g_jit26Pool.freeList.clear();
+		g_jit26Pool.freeList[0] = size;
+		g_jit26Pool.active = true;
+		success = true;
+	}
+
+	//Regions can't be added after detaching, so everything above must happen first
+	HushJIT26Detach();
+	return success;
+#else
+	return false;
+#endif
+}
+
+#else
+
+bool CMemoryFunction::IsJit26Active()
+{
+	return false;
+}
+
+bool CMemoryFunction::InitializeJit26(size_t)
+{
+	return false;
+}
+
+#endif

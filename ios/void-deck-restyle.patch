+static NSString* const FavoritesKey = @"voiddeck.favorites";
+
+static NSString* PathKey(const BootablesDb::Bootable& b)
+{
+	return [NSString stringWithUTF8String:b.path.native().c_str()];
+}
+
+static NSSet<NSString*>* LoadFavorites()
+{
+	return [NSSet setWithArray:[[NSUserDefaults standardUserDefaults] arrayForKey:FavoritesKey] ?: @[]];
+}
+
+// Scope 0 = A-Z (favorites first), 1 = recently played, 2 = favorites only.
+- (void)refreshVisible
+{
+	NSInteger scope = self.navigationItem.searchController.searchBar.selectedScopeButtonIndex;
+	NSSet<NSString*>* favorites = LoadFavorites();
+	_visible = [NSMutableArray array];
+	if(_bootables)
+	{
+		for(NSUInteger i = 0; i < _bootables->size(); i++)
+		{
+			NSString* title = [NSString stringWithUTF8String:(*_bootables)[i].title.c_str()];
+			bool fav = [favorites containsObject:PathKey((*_bootables)[i])];
+			if(scope == 2 && !fav) continue;
+			if(scope == 1 && (*_bootables)[i].lastBootedTime == 0) continue;
+			if([_query length] == 0 || [title rangeOfString:_query options:NSCaseInsensitiveSearch].location != NSNotFound)
+			{
+				[_visible addObject:@(i)];
+			}
+		}
+		[_visible sortUsingComparator:^NSComparisonResult(NSNumber* a, NSNumber* b) {
+		  const auto& ba = (*self->_bootables)[a.unsignedIntegerValue];
+		  const auto& bb = (*self->_bootables)[b.unsignedIntegerValue];
+		  if(scope == 1 && ba.lastBootedTime != bb.lastBootedTime)
+			  return ba.lastBootedTime > bb.lastBootedTime ? NSOrderedAscending : NSOrderedDescending;
+		  bool fa = [favorites containsObject:PathKey(ba)], fb = [favorites containsObject:PathKey(bb)];
+		  if(scope == 0 && fa != fb) return fa ? NSOrderedAscending : NSOrderedDescending;
+		  NSString* ta = [NSString stringWithUTF8String:(*self->_bootables)[a.unsignedIntegerValue].title.c_str()];
+		  NSString* tb = [NSString stringWithUTF8String:(*self->_bootables)[b.unsignedIntegerValue].title.c_str()];
+		  return [ta localizedCaseInsensitiveCompare:tb];
+		}];
+	}
+	[self.collectionView reloadData];
+}
+
+- (void)updateSearchResultsForSearchController:(UISearchController*)searchController
+{
+	_query = searchController.searchBar.text;
+	[self refreshVisible];
+}

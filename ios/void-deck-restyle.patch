+#import "PadSkin.h"
+
+static UIColor* RGB(int r, int g, int b, CGFloat a)
+{
+	return [UIColor colorWithRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:a];
+}
+
+static void FillGradient(CGContextRef ctx, NSArray<UIColor*>* colors, CGPoint from, CGPoint to)
+{
+	NSMutableArray* cg = [NSMutableArray array];
+	for(UIColor* c in colors) [cg addObject:(id)c.CGColor];
+	CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+	CGGradientRef g = CGGradientCreateWithColors(space, (CFArrayRef)cg, NULL);
+	CGContextDrawLinearGradient(ctx, g, from, to, 0);
+	CGGradientRelease(g);
+	CGColorSpaceRelease(space);
+}
+
+static void FillRadial(CGContextRef ctx, NSArray<UIColor*>* colors, CGPoint center, CGFloat radius)
+{
+	NSMutableArray* cg = [NSMutableArray array];
+	for(UIColor* c in colors) [cg addObject:(id)c.CGColor];
+	CGColorSpaceRef space = CGColorSpaceCreateDeviceRGB();
+	CGGradientRef g = CGGradientCreateWithColors(space, (CFArrayRef)cg, NULL);
+	CGContextDrawRadialGradient(ctx, g, CGPointMake(center.x, center.y - radius * 0.3), 0, center, radius, kCGGradientDrawsAfterEndLocation);
+	CGGradientRelease(g);
+	CGColorSpaceRelease(space);
+}
+
+// Draws a glossy body (clipped path) with a soft drop shadow and rim light.
+static void DrawBody(CGContextRef ctx, UIBezierPath* path, BOOL pressed, BOOL radial)
+{
+	CGRect b = path.bounds;
+	CGContextSaveGState(ctx);
+	if(!pressed)
+	{
+		CGContextSetShadowWithColor(ctx, CGSizeMake(0, 3), 6, [UIColor colorWithWhite:0 alpha:0.55].CGColor);
+	}
+	[RGB(20, 22, 28, 0.92) setFill];
+	[path fill];
+	CGContextRestoreGState(ctx);
+
+	CGContextSaveGState(ctx);
+	[path addClip];
+	NSArray* tones = pressed ? @[ RGB(18, 20, 24, 0.95), RGB(40, 44, 54, 0.95) ]
+	                         : @[ RGB(78, 84, 98, 0.95), RGB(28, 31, 38, 0.95) ];
+	if(radial)
+		FillRadial(ctx, tones, CGPointMake(CGRectGetMidX(b), CGRectGetMidY(b)), b.size.width * 0.6);
+	else
+		FillGradient(ctx, tones, CGPointMake(0, CGRectGetMinY(b)), CGPointMake(0, CGRectGetMaxY(b)));
+	CGContextRestoreGState(ctx);
+
+	[RGB(255, 255, 255, pressed ? 0.10 : 0.28) setStroke];
+	path.lineWidth = 1;
+	[path stroke];
+}
+
+static void DrawGlyph(NSString* kind, CGRect r, UIColor* color)
+{
+	CGFloat s = r.size.width * 0.34;
+	CGPoint c = CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r));
+	UIBezierPath* p = nil;
+	if([kind isEqualToString:@"circle"])
+		p = [UIBezierPath bezierPathWithOvalInRect:CGRectMake(c.x - s, c.y - s, s * 2, s * 2)];
+	else if([kind isEqualToString:@"square"])
+		p = [UIBezierPath bezierPathWithRect:CGRectMake(c.x - s * 0.9, c.y - s * 0.9, s * 1.8, s * 1.8)];
+	else if([kind isEqualToString:@"triangle"])
+	{
+		p = [UIBezierPath bezierPath];
+		[p moveToPoint:CGPointMake(c.x, c.y - s)];
+		[p addLineToPoint:CGPointMake(c.x + s * 1.05, c.y + s * 0.8)];
+		[p addLineToPoint:CGPointMake(c.x - s * 1.05, c.y + s * 0.8)];
+		[p closePath];
+	}
+	else
+	{
+		p = [UIBezierPath bezierPath];
+		[p moveToPoint:CGPointMake(c.x - s, c.y - s)];
+		[p addLineToPoint:CGPointMake(c.x + s, c.y + s)];
+		[p moveToPoint:CGPointMake(c.x + s, c.y - s)];
+		[p addLineToPoint:CGPointMake(c.x - s, c.y + s)];
+	}
+	p.lineWidth = MAX(2.0, r.size.width * 0.07);
+	p.lineCapStyle = kCGLineCapRound;
+	[color setStroke];
+	[p stroke];
+}
+
+static void DrawArrow(NSString* kind, CGRect r)
+{
+	CGPoint c = CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r));
+	CGFloat s = MIN(r.size.width, r.size.height) * 0.22;
+	CGFloat dx = 0, dy = 0;
+	if([kind isEqualToString:@"up"]) dy = -1;
+	else if([kind isEqualToString:@"down"]) dy = 1;
+	else if([kind isEqualToString:@"left"]) dx = -1;
+	else dx = 1;
+	UIBezierPath* p = [UIBezierPath bezierPath];
+	[p moveToPoint:CGPointMake(c.x + dx * s, c.y + dy * s)];
+	[p addLineToPoint:CGPointMake(c.x - dx * s + dy * s, c.y - dy * s + dx * s)];
+	[p addLineToPoint:CGPointMake(c.x - dx * s - dy * s, c.y - dy * s - dx * s)];
+	[p closePath];
+	[RGB(210, 216, 228, 0.85) setFill];
+	[p fill];
+}
+
+@implementation PadSkin
+
++ (void)drawKind:(NSString*)kind caption:(NSString*)caption inRect:(CGRect)rect pressed:(BOOL)pressed context:(CGContextRef)ctx
+{
+	if([kind isEqualToString:@"cross"] || [kind isEqualToString:@"circle"] ||
+	   [kind isEqualToString:@"square"] || [kind isEqualToString:@"triangle"])
+	{
+		CGFloat d = MIN(rect.size.width, rect.size.height) - 8;
+		CGRect face = CGRectMake(CGRectGetMidX(rect) - d / 2, CGRectGetMidY(rect) - d / 2, d, d);
+		if(pressed) face = CGRectInset(face, 2, 2);
+		DrawBody(ctx, [UIBezierPath bezierPathWithOvalInRect:face], pressed, YES);
+		UIColor* col = [kind isEqualToString:@"triangle"] ? RGB(64, 224, 160, 1)
+		             : [kind isEqualToString:@"circle"]   ? RGB(255, 84, 96, 1)
+		             : [kind isEqualToString:@"cross"]    ? RGB(96, 160, 255, 1)
+		                                                  : RGB(255, 150, 210, 1);
+		DrawGlyph(kind, face, col);
+	}
+	else if([kind isEqualToString:@"up"] || [kind isEqualToString:@"down"] ||
+	        [kind isEqualToString:@"left"] || [kind isEqualToString:@"right"])
+	{
+		CGRect arm = CGRectInset(rect, rect.size.width * 0.12, rect.size.height * 0.12);
+		DrawBody(ctx, [UIBezierPath bezierPathWithRoundedRect:arm cornerRadius:MIN(arm.size.width, arm.size.height) * 0.28], pressed, NO);
+		DrawArrow(kind, arm);
+	}
+	else if([kind isEqualToString:@"select"] || [kind isEqualToString:@"start"])
+	{
+		CGRect pill = CGRectInset(rect, 4, rect.size.height * 0.28);
+		DrawBody(ctx, [UIBezierPath bezierPathWithRoundedRect:pill cornerRadius:pill.size.height / 2], pressed, NO);
+		NSDictionary* attrs = @{ NSFontAttributeName : [UIFont systemFontOfSize:MAX(8, pill.size.height * 0.4) weight:UIFontWeightSemibold],
+			                     NSForegroundColorAttributeName : RGB(210, 216, 228, 0.9) };
+		NSString* t = [kind isEqualToString:@"start"] ? @"START" : @"SELECT";
+		CGSize ts = [t sizeWithAttributes:attrs];
+		[t drawAtPoint:CGPointMake(CGRectGetMidX(pill) - ts.width / 2, CGRectGetMidY(pill) - ts.height / 2) withAttributes:attrs];
+	}
+	else // shoulder / stick-click
+	{
+		CGRect pill = CGRectInset(rect, 4, 4);
+		DrawBody(ctx, [UIBezierPath bezierPathWithRoundedRect:pill cornerRadius:MIN(pill.size.width, pill.size.height) * 0.4], pressed, NO);
+		if([caption length])
+		{
+			NSDictionary* attrs = @{ NSFontAttributeName : [UIFont systemFontOfSize:15 weight:UIFontWeightBold],
+				                     NSForegroundColorAttributeName : RGB(210, 216, 228, 0.9) };
+			CGSize ts = [caption sizeWithAttributes:attrs];
+			[caption drawAtPoint:CGPointMake(CGRectGetMidX(pill) - ts.width / 2, CGRectGetMidY(pill) - ts.height / 2) withAttributes:attrs];
+		}
+	}
+}
+
++ (void)drawStickBase:(CGRect)rect context:(CGContextRef)ctx
+{
+	CGRect well = CGRectInset(rect, rect.size.width * 0.08, rect.size.height * 0.08);
+	UIBezierPath* p = [UIBezierPath bezierPathWithOvalInRect:well];
+	CGContextSaveGState(ctx);
+	[p addClip];
+	FillGradient(ctx, @[ RGB(8, 9, 12, 0.85), RGB(44, 48, 58, 0.85) ], CGPointMake(0, CGRectGetMinY(well)), CGPointMake(0, CGRectGetMaxY(well)));
+	CGContextRestoreGState(ctx);
+	[RGB(255, 255, 255, 0.18) setStroke];
+	p.lineWidth = 1.5;
+	[p stroke];
+}
+
++ (void)drawStickCap:(CGRect)rect context:(CGContextRef)ctx
+{
+	CGRect cap = CGRectInset(rect, rect.size.width * 0.2, rect.size.height * 0.2);
+	DrawBody(ctx, [UIBezierPath bezierPathWithOvalInRect:cap], NO, YES);
+	// concave grip ring
+	UIBezierPath* ring = [UIBezierPath bezierPathWithOvalInRect:CGRectInset(cap, cap.size.width * 0.18, cap.size.height * 0.18)];
+	[RGB(0, 0, 0, 0.35) setStroke];
+	ring.lineWidth = 2;
+	[ring stroke];
+}
+
+@end

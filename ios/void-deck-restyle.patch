+// Adaptive poster grid: ~2:3 box-art cards, 2-5 columns depending on width.
+- (void)applyGridLayout:(CGSize)size
+{
+	auto layout = (UICollectionViewFlowLayout*)self.collectionView.collectionViewLayout;
+	const CGFloat spacing = 18, inset = 20;
+	NSInteger columns = MAX(2, (NSInteger)floor((size.width - inset * 2 + spacing) / (150 + spacing)));
+	CGFloat width = floor((size.width - inset * 2 - spacing * (columns - 1)) / columns);
+	layout.itemSize = CGSizeMake(width, ceil(width * 1.42));
+	layout.minimumInteritemSpacing = spacing;
+	layout.minimumLineSpacing = spacing + 4;
+	layout.sectionInset = UIEdgeInsetsMake(16, inset, 24, inset);
+}
+
+- (void)viewWillTransitionToSize:(CGSize)size withTransitionCoordinator:(id<UIViewControllerTransitionCoordinator>)coordinator
+{
+	[super viewWillTransitionToSize:size withTransitionCoordinator:coordinator];
+	[self applyGridLayout:size];
+	[self.collectionView.collectionViewLayout invalidateLayout];
+}

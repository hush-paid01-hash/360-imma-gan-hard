+
+static UIColor* VDColor(int r, int g, int b)
+{
+	return [UIColor colorWithRed:r / 255.0 green:g / 255.0 blue:b / 255.0 alpha:1];
+}
+
+- (void)applyVoidDeckTheme
+{
+	self.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
+	self.tableView.backgroundColor = VDColor(11, 13, 16);
+	self.tableView.separatorColor = [UIColor colorWithWhite:1 alpha:0.08];
+	self.tableView.tintColor = VDColor(182, 255, 60);
+	self.navigationController.navigationBar.tintColor = VDColor(182, 255, 60);
+	self.navigationController.navigationBar.barTintColor = VDColor(11, 13, 16);
+	self.navigationController.navigationBar.titleTextAttributes = @{ NSForegroundColorAttributeName : [UIColor whiteColor] };
+	for(UISwitch* s in @[ showFpsSwitch, showVirtualPadSwitch, hideVirtualPadWhenControllerConnected, virtualPadHapticFeedbackSwitch, resizeOutputToWidescreen, forceBilinearFiltering, enableAudioOutput, enableAltServerJIT ])
+	{
+		s.onTintColor = VDColor(182, 255, 60);
+	}
+	virtualPadOpacitySlider.minimumTrackTintColor = VDColor(182, 255, 60);
+}
+
+- (void)tableView:(UITableView*)tableView willDisplayCell:(UITableViewCell*)cell forRowAtIndexPath:(NSIndexPath*)indexPath
+{
+	cell.backgroundColor = VDColor(22, 26, 32);
+	for(UIView* v in cell.contentView.subviews)
+	{
+		if([v isKindOfClass:[UILabel class]]) ((UILabel*)v).textColor = [UIColor colorWithWhite:0.92 alpha:1];
+	}
+}
+
+- (void)tableView:(UITableView*)tableView willDisplayHeaderView:(UIView*)view forSection:(NSInteger)section
+{
+	if([view isKindOfClass:[UITableViewHeaderFooterView class]])
+	{
+		auto header = (UITableViewHeaderFooterView*)view;
+		header.textLabel.textColor = VDColor(182, 255, 60);
+		header.textLabel.font = [UIFont monospacedSystemFontOfSize:12 weight:UIFontWeightBold];
+		header.textLabel.text = [header.textLabel.text uppercaseString];
+	}
 }
 

+// Thumb-friendly landscape layout: d-pad and face diamond at the edges,
+// sticks inset toward the center, shoulders as wide pills in the top corners,
+// and L3/SELECT/START/R3 in one row between the sticks.
+- (void)applyErgonomicLayout:(NSArray<VirtualPadItem*>*)items size:(CGSize)size
+{
+	using B = PS2::CControllerInfo;
+	const CGFloat w = size.width, h = size.height;
+	NSInteger sizeIdx = [[NSUserDefaults standardUserDefaults] objectForKey:@"voiddeck.padSize"] ? [[NSUserDefaults standardUserDefaults] integerForKey:@"voiddeck.padSize"] : 1;
+	const CGFloat sizeScale = sizeIdx == 0 ? 0.85 : (sizeIdx == 2 ? 1.2 : 1.0);
+	const CGFloat u = MAX(30, MIN(MIN(h * 0.16, w * 0.07), 60)) * sizeScale;
+	const CGFloat m = MAX(16, u * 0.5);
+	const CGFloat baseY = h - m;
+	const CGFloat stick = u * 1.7;
+	const CGFloat pillW = u * 1.7, pillH = u * 0.62;
+
+	auto setRect = [](VirtualPadItem* it, CGFloat cx, CGFloat cy, CGFloat iw, CGFloat ih) {
+		it.bounds = CGRectMake(cx - iw / 2, cy - ih / 2, iw, ih);
+	};
+
+	CGPoint dpad = CGPointMake(m + u * 1.5, baseY - u * 1.5);
+	CGPoint face = CGPointMake(w - m - u * 1.5, baseY - u * 1.5);
+	CGFloat stickY = baseY - stick / 2;
+	CGFloat midX = w / 2;
+	CGFloat rowY = baseY - u * 0.45;
+
+	for(VirtualPadItem* it in items)
+	{
+		if([it isKindOfClass:[VirtualPadStick class]])
+		{
+			bool left = ((VirtualPadStick*)it).codeX == B::ANALOG_LEFT_X;
+			setRect(it, left ? w * 0.34 : w * 0.66, stickY, stick, stick);
+			continue;
+		}
+		if(![it isKindOfClass:[VirtualPadButton class]]) continue;
+		switch(((VirtualPadButton*)it).code)
+		{
+		case B::DPAD_UP: setRect(it, dpad.x, dpad.y - u, u, u); break;
+		case B::DPAD_DOWN: setRect(it, dpad.x, dpad.y + u, u, u); break;
+		case B::DPAD_LEFT: setRect(it, dpad.x - u, dpad.y, u, u); break;
+		case B::DPAD_RIGHT: setRect(it, dpad.x + u, dpad.y, u, u); break;
+		case B::TRIANGLE: setRect(it, face.x, face.y - u * 1.05, u, u); break;
+		case B::CROSS: setRect(it, face.x, face.y + u * 1.05, u, u); break;
+		case B::SQUARE: setRect(it, face.x - u * 1.05, face.y, u, u); break;
+		case B::CIRCLE: setRect(it, face.x + u * 1.05, face.y, u, u); break;
+		case B::L2: setRect(it, m + pillW / 2, m / 2 + pillH / 2, pillW, pillH); break;
+		case B::L1: setRect(it, m + pillW / 2, m / 2 + pillH * 1.6, pillW, pillH); break;
+		case B::R2: setRect(it, w - m - pillW / 2, m / 2 + pillH / 2, pillW, pillH); break;
+		case B::R1: setRect(it, w - m - pillW / 2, m / 2 + pillH * 1.6, pillW, pillH); break;
+		case B::SELECT: setRect(it, midX - u * 0.65, rowY, u * 1.1, u * 0.7); break;
+		case B::START: setRect(it, midX + u * 0.65, rowY, u * 1.1, u * 0.7); break;
+		case B::L3: setRect(it, midX - u * 1.9, rowY, u * 0.8, u * 0.8); break;
+		case B::R3: setRect(it, midX + u * 1.9, rowY, u * 0.8, u * 0.8); break;
+		default: break;
+		}
+	}
+}
+
 - (void)drawRect:(CGRect)rect
 {
 	[super drawRect:rect];

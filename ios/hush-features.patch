+static float ApplyDeadzone(float v)
+{
+	NSUserDefaults* d = [NSUserDefaults standardUserDefaults];
+	float dz = [d objectForKey:@"hush.deadzone"] ? [d floatForKey:@"hush.deadzone"] : 0.1f;
+	float a = fabsf(v);
+	if(a <= dz) return 0;
+	float scaled = (a - dz) / (1.0f - dz);
+	return v < 0 ? -scaled : scaled;
+}

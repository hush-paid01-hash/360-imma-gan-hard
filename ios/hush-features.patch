+- (UIView*)hushSwitchRow:(NSString*)title key:(NSString*)key action:(SEL)action on:(BOOL)on
+{
+	UILabel* label = [[UILabel alloc] init];
+	label.text = title;
+	label.textColor = [UIColor colorWithWhite:0.92 alpha:1];
+	label.numberOfLines = 0;
+	UISwitch* toggle = [[UISwitch alloc] init];
+	toggle.on = on;
+	toggle.onTintColor = VDColor(182, 255, 60);
+	toggle.accessibilityIdentifier = key;
+	[toggle addTarget:self action:action forControlEvents:UIControlEventValueChanged];
+	[toggle setContentHuggingPriority:UILayoutPriorityRequired forAxis:UILayoutConstraintAxisHorizontal];
+	UIStackView* row = [[UIStackView alloc] initWithArrangedSubviews:@[ label, toggle ]];
+	row.alignment = UIStackViewAlignmentCenter;
+	row.spacing = 12;
+	return row;
+}
